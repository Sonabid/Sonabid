						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "Temp_SqlServer",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "ForEach_Sales_Table",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Get_Sales_Tables",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Get_Sales_Tables').output.value",
						"type": "Expression"
					},
					"activities": [
						{
