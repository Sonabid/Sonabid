{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "Dibanosdatafactory"
		},
		"Cloud_AzureDataLakeStorage_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'Cloud_AzureDataLakeStorage'"
		},
		"Cloud_AzureDataLakeStorage_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://dibanosdatalake.dfs.core.windows.net/"
		},
		"Dibanos_Linked_Key_Vault_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://Dibanoskeyvault.vault.azure.net/"
		},
		"OnPrem_SQLsever_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "D\\SQLEXPRESS"
		},
		"OnPrem_SQLsever_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "AdventureWorksLT2022"
		},
		"OnPrem_SQLsever_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "Dibanos"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "Dibanosdatafactory_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"Cloud_AzureDataLakeStorage_accountKey": {
						"value": "[parameters('Cloud_AzureDataLakeStorage_accountKey')]"
					},
					"Cloud_AzureDataLakeStorage_properties_typeProperties_url": {
						"value": "[parameters('Cloud_AzureDataLakeStorage_properties_typeProperties_url')]"
					},
					"Dibanos_Linked_Key_Vault_properties_typeProperties_baseUrl": {
						"value": "[parameters('Dibanos_Linked_Key_Vault_properties_typeProperties_baseUrl')]"
					},
					"OnPrem_SQLsever_properties_typeProperties_server": {
						"value": "[parameters('OnPrem_SQLsever_properties_typeProperties_server')]"
					},
					"OnPrem_SQLsever_properties_typeProperties_database": {
						"value": "[parameters('OnPrem_SQLsever_properties_typeProperties_database')]"
					},
					"OnPrem_SQLsever_properties_typeProperties_userName": {
						"value": "[parameters('OnPrem_SQLsever_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}